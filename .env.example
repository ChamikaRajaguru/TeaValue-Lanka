# =====================================================================
# TeaValue Lanka - Environment Configuration Template
# =====================================================================
# Copy this file to .env.local for local development.

# ---------------------------------------------------------------------
# Application URL
# ---------------------------------------------------------------------
APP_URL=http://localhost:3000
PORT=3000

# ---------------------------------------------------------------------
# Database Configuration (MongoDB)
# Optional in DEMO_MODE; required for persistent MongoDB storage.
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/teavalue?retryWrites=true&w=majority
# ---------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/teavalue_lanka
MONGODB_DB_NAME=teavalue_lanka

# ---------------------------------------------------------------------
# Authentication (Better Auth)
# Generate a random 32+ character string for BETTER_AUTH_SECRET
# e.g.: openssl rand -base64 32
# ---------------------------------------------------------------------
BETTER_AUTH_SECRET=changeme_in_production_min_32_chars_random_secret_string_12345
BETTER_AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------
# Google Gemini API (Optional)
# Used only by administrators for discovering published market price candidates.
# Estimates continue to function reliably from verified MongoDB records if omitted.
# ---------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------
# Demonstration Mode
# Set to 'true' to run with synthetic demo factories, prices, and rules.
# A clear "Demo data — not actual market prices" badge is displayed.
# ---------------------------------------------------------------------
DEMO_MODE=false

# ---------------------------------------------------------------------
# Email Provider Settings (Optional)
# If left blank, verification and reset emails will log tokens safely to server console.
# ---------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="TeaValue Lanka <noreply@teavalue.lk>"

# ---------------------------------------------------------------------
# Rate Limiting Storage
# memory (single node) or mongodb (cluster multi-instance)
# ---------------------------------------------------------------------
RATE_LIMIT_STORAGE=memory
